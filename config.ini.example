# Конфиг letsencrypt-certificate
# Скопируйте в config.ini и заполните значения

[log]
file               = /var/log/letsencrypt-certificate/app.log
certificate_folder = /var/lib/letsencrypt-certificate/certs
nic_token_file     = /var/lib/letsencrypt-certificate/nic_token.json

# ---------- Уведомления ----------
# Поддерживается один или несколько блоков [notifier.*]
# В будущем можно добавить [notifier.slack], [notifier.email] и т.д.

[notifier.telegram]
enabled   = true
token     = 123456:ABC-DEF-GHI...
recipient = -100123456789

# ---------- Let's Encrypt ----------

[acme]
# Для тестов используйте staging:
# directory_url = https://acme-staging-v02.api.letsencrypt.org/directory
directory_url = https://acme-v02.api.letsencrypt.org/directory
email         = admin@example.ru

# ---------- NIC.RU DNS ----------

[nic]
app_login    = myapp
app_password = myapp_secret
username     = myuser@nic.ru
password     = mypassword
service      = myservice
domain       = example.ru

# ---------- DNS проверка ----------

[dns]
# Интервал между проверками TXT записи (секунды)
check_interval_sec = 300
# Максимальное кол-во попыток (300 * 60 = ~5 часов)
check_max_attempts = 60

# ---------- Сертификаты ----------
# Для каждого сертификата создайте блок [certificate "имя"]
# deploy_type: local | ssh

[certificate "web-server"]
domains        = example.ru
ports          = 443
deploy_type    = local
private_path   = /etc/apache2/ssl/private.pem
fullchain_path = /etc/apache2/ssl/fullchain.pem
commands       = sudo systemctl restart apache2

[certificate "nginx-remote"]
domains        = www.example.ru, example.ru
ports          = 443
deploy_type    = ssh
ssh_host       = 10.0.0.1
ssh_username   = admin
ssh_key_path   = keys/id_rsa
ssh_private_path   = /etc/nginx/ssl/private.pem
ssh_fullchain_path = /etc/nginx/ssl/fullchain.pem
commands       = killall nginx, nginx

[certificate "mail"]
domains        = mail.example.ru
ports          = 465, 993
deploy_type    = ssh
ssh_host       = 10.0.0.2
ssh_username   = admin
ssh_key_path   = keys/id_rsa_mail
ssh_private_path   = /etc/postfix/ssl/private.pem
ssh_fullchain_path = /etc/postfix/ssl/fullchain.pem
commands       = sudo systemctl restart postfix, sudo systemctl restart dovecot
